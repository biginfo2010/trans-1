               <rdf:li xml:lang="x-default">Leather dyeing auxiliary composition - European Patent Office - EP 0432686 A1</rdf:li>
               <rdf:li xml:lang="en">Leather dyeing auxiliary composition - European Patent Office - EP 0432686 A1</rdf:li>
            </rdf:Alt>
